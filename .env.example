APP_PORT=26406
GIN_MODE=debug
# 生产/ Docker 建议使用 release；见 docker-compose.example.yml
# GIN_TRUSTED_PROXIES=127.0.0.1,::1
DB_TYPE=sqlite
DB_DSN=data.db
# DB_TYPE=mysql
# DB_DSN=root:password@tcp(localhost:3306)/clash_config_store?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY_HOURS=720
GEOIP_PATH=
# Optional public base URL for generated absolute subscription links.
# Leave unset to let the frontend use the current page origin.
# Hosted rule-set URLs still require a public BASE_URL.
# BASE_URL=https://panel.example.com
